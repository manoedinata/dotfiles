#!/bin/sh
# Start labwc on a locally patched wlroots (fractional-snap.patch next to each lib).
# Default: labwc 0.20.3 in /opt/henn, linked (rpath) to wlroots 0.20.2 in /opt/henn/lib,
# both installed by henn-dotfiles/desktop (install.sh). It adds per-window screen sharing
# (ext-foreign-toplevel-image-capture-source-v1), which wlroots 0.19 lacks.
# Without it, the older build in ~/.local/opt/labwc-0.20 is used.
# LABWC_LEGACY=1 (the "labwc 0.9 legacy" session) starts the apt labwc 0.9.3 on the
# patched wlroots 0.19 in ~/.local/opt/wlroots-patched instead.
labwc_bin=/opt/henn/bin/labwc
[ -x "$labwc_bin" ] || labwc_bin="$HOME/.local/opt/labwc-0.20/bin/labwc"
if [ -n "$LABWC_LEGACY" ] || [ ! -x "$labwc_bin" ]; then
    labwc_bin=labwc
    export LD_LIBRARY_PATH="$HOME/.local/opt/wlroots-patched/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
unset LABWC_LEGACY

# HDMI and DP are wired to the NVIDIA GPU. /etc/environment forces Mesa-only EGL,
# which left labwc without an NVIDIA renderer, and it then oopsed in
# nv_drm_framebuffer_create when driving the external display.
# Display connected at login, or firmware igpumode=0: allow NVIDIA EGL for labwc.
# igpumode=0 keeps the GPU attached on battery, so labwc can hold it and HDMI hot-plugs.
# Otherwise (Hybrid-Auto, igpumode=2) labwc must stay off the NVIDIA GPU: firmware removes
# it on unplug and the removal hangs while labwc holds it. There, a display plugged in
# after login needs a new login to appear.
external=
for status in /sys/class/drm/card*-HDMI-A-*/status /sys/class/drm/card*-DP-*/status; do
    [ "$(cat "$status" 2>/dev/null)" = connected ] && external=1
done

igpumode=
for mode in /sys/class/hwmon/hwmon*/device/igpumode; do
    [ -r "$mode" ] && igpumode=$(cat "$mode")
done

if [ -n "$external" ] || [ "$igpumode" = 0 ]; then
    unset __EGL_VENDOR_LIBRARY_FILENAMES
else
    for card in /sys/class/drm/card[0-9] /sys/class/drm/card[0-9][0-9]; do
        [ "$(basename "$(readlink "$card/device/driver" 2>/dev/null)" 2>/dev/null)" = i915 ] &&
            export WLR_DRM_DEVICES="/dev/dri/${card##*/}"
    done
fi

exec "$labwc_bin" "$@"
