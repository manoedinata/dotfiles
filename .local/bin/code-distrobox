#!/bin/sh

if [ -z "$2" ]; then
	container_name=ros1
else
	container_name=$2
fi

container_name="$(printf '{"containerName":"%s"}' "$container_name" | od -A n -t x1 | tr -d "\n\t ")"

echo "Opening on $container_name"

if command -v code 2> /dev/null > /dev/null; then
	code_command="code"
elif flatpak list | grep -q com.visualstudio.code; then
	code_command="flatpak run com.visualstudio.code"
else
	echo "vscode not installed"
	exit 127
fi

${code_command} --folder-uri="vscode-remote://attached-container+${container_name}/$(realpath "${1}")"
