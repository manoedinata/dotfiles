#!/usr/bin/env bash
# Switch between extend, mirror and internal on labwc.
# Extend is the normal behaviour. Mirror runs wl-mirror fullscreen on the
# external output, showing the laptop panel. Internal disables the external
# output, and extend or mirror enable it again.
# Usage: display-mode [status|toggle|mirror|extend|internal]
#        display-mode [modes|set-mode MODE|confirm-mode|revert-mode|restore-mode]
#        display-mode [placement|set-placement left|above|right]

source_output() {
    wlr-randr --json | jq -r '.[] | select(.enabled) | .name | select(startswith("eDP"))' | head -n 1
}

external_output() {
    wlr-randr --json | jq -r '.[] | select(.enabled) | .name | select(startswith("eDP") | not)' | head -n 1
}

disabled_external() {
    wlr-randr --json | jq -r '.[] | select(.enabled | not) | .name | select(startswith("eDP") | not)' | head -n 1
}

is_mirroring() {
    pgrep -x wl-mirror >/dev/null
}

# wl-mirror is only a window, so the external output stays in the layout and the
# cursor can reach it. While mirroring, park that output past a gap: wlroots clamps
# the cursor to the nearest output, so it stays on the laptop panel.
park_x=10000

park() {
    # labwc auto-places any output without an explicit position, so set both.
    # The panel keeps its position: windows keep their layout coordinates, so
    # moving the panel would drop them on the other output.
    wlr-randr --output "$1" --pos "$(position "$1")" --output "$2" --pos "$park_x,0"
}

position() {
    wlr-randr --json | jq -r --arg o "$1" '.[] | select(.name == $o) | "\(.position.x),\(.position.y)"'
}

# Mode changes revert on their own unless confirmed, because a mode the monitor
# cannot show leaves it black. The timer lives here, not in the shell UI, so it
# still fires if DMS dies. Confirmed modes are stored per monitor.
pending_file="${XDG_RUNTIME_DIR:-/tmp}/display-mode-pending"
saved_dir="${XDG_STATE_HOME:-$HOME/.local/state}/display-mode"
revert_seconds=15

external_json() {
    wlr-randr --json | jq -c '[.[] | select(.enabled) | select(.name | startswith("eDP") | not)][0] // empty'
}

mode_filter='def mode_id: "\(.width)x\(.height)@\((.refresh * 1000 | round) / 1000)Hz";'

saved_file() {
    printf '%s/%s\n' "$saved_dir" "$(jq -r '"\(.make)-\(.model)-\(.serial)"' <<<"$1" | tr -c 'A-Za-z0-9._\n-' _)"
}

modes() {
    local ext
    ext=$(external_json)
    [ -n "$ext" ] || { echo '{"output":"","modes":[]}'; return 0; }
    jq -c "$mode_filter"' {output: .name, modes: [.modes[] | {width, height, refresh, current, id: mode_id}] | unique_by(.id)}' <<<"$ext"
}

# Where the external output sits relative to the panel, stored per monitor.
placement_file() {
    printf '%s.placement\n' "$(saved_file "$1")"
}

placement() {
    local ext file
    ext=$(external_json)
    [ -n "$ext" ] || { echo right; return 0; }
    file=$(placement_file "$ext")
    if [ -s "$file" ]; then cat "$file"; else echo right; fi
}

logical_size() {
    wlr-randr --json | jq -r --arg o "$1" \
        '.[] | select(.name == $o) | . as $out | .modes[] | select(.current) | "\(.width / $out.scale | round) \(.height / $out.scale | round)"'
}

# Lay out both outputs from the saved placement. Coordinates stay positive, so
# for left and above the panel moves instead of the external output.
place() {
    local src dst src_w src_h dst_w dst_h
    src=$(source_output)
    dst=$(external_output)
    [ -n "$dst" ] || return 0
    read -r src_w src_h <<<"$(logical_size "$src")"
    read -r dst_w dst_h <<<"$(logical_size "$dst")"
    case "$(placement)" in
        left) wlr-randr --output "$dst" --pos 0,0 --output "$src" --pos "$dst_w,0" ;;
        above) wlr-randr --output "$dst" --pos 0,0 --output "$src" --pos "0,$dst_h" ;;
        *) wlr-randr --output "$src" --pos 0,0 --output "$dst" --pos "$src_w,0" ;;
    esac
}

# Mirroring keeps the external output parked. `extend` places it again later.
apply_placement() {
    is_mirroring || place
}

set_placement() {
    local where=$1 ext file
    case "$where" in
        left | above | right) ;;
        *) echo "placement must be left, above or right" >&2; return 2 ;;
    esac
    ext=$(external_json)
    [ -n "$ext" ] || return 1
    file=$(placement_file "$ext")
    mkdir -p "$saved_dir"
    echo "$where" >"$file"
    apply_placement
}

set_mode() {
    local mode=$1 ext name previous token
    ext=$(external_json)
    [ -n "$ext" ] || return 1
    name=$(jq -r .name <<<"$ext")
    # A second change before confirming still reverts to the last confirmed mode.
    if [ -s "$pending_file" ]; then
        read -r _ previous _ _ <"$pending_file"
    else
        previous=$(jq -r "$mode_filter"' .modes[] | select(.current) | mode_id' <<<"$ext")
    fi
    token="$$-$(date +%s%N)"
    echo "$name $previous $mode $token" >"$pending_file"
    if ! wlr-randr --output "$name" --mode "$mode"; then
        revert_mode
        return 1
    fi
    apply_placement
    setsid -f sh -c 'sleep "$1"; exec "$0" revert-mode "$2"' "$0" "$revert_seconds" "$token" >/dev/null 2>&1
}

confirm_mode() {
    local mode file
    [ -s "$pending_file" ] || return 0
    read -r _ _ mode _ <"$pending_file"
    file=$(saved_file "$(external_json)")
    mkdir -p "$saved_dir"
    echo "$mode" >"$file"
    rm -f "$pending_file"
}

# With a token, only revert the change that token belongs to.
revert_mode() {
    local name previous token
    [ -s "$pending_file" ] || return 0
    read -r name previous _ token <"$pending_file"
    [ -z "${1:-}" ] || [ "$1" = "$token" ] || return 0
    wlr-randr --output "$name" --mode "$previous"
    rm -f "$pending_file"
    apply_placement
}

restore_mode() {
    local ext file
    ext=$(external_json)
    [ -n "$ext" ] || return 0
    file=$(saved_file "$ext")
    [ -s "$file" ] && wlr-randr --output "$(jq -r .name <<<"$ext")" --mode "$(cat "$file")"
    apply_placement
}

# Undo `internal`. The saved mode and placement apply again as at login.
enable_external() {
    local name
    name=$(disabled_external)
    [ -n "$name" ] || return 0
    wlr-randr --output "$name" --on
    restore_mode
}

status() {
    if [ -n "$(disabled_external)" ]; then
        echo internal
    elif [ -z "$(external_output)" ]; then
        echo none
    elif is_mirroring; then
        echo mirror
    else
        echo extend
    fi
}

mirror() {
    local src dst
    enable_external
    src=$(source_output)
    dst=$(external_output)
    if [ -z "$dst" ]; then
        dms ipc call toast warn "No external display connected" >/dev/null 2>&1
        echo "no external display connected" >&2
        return 1
    fi
    park "$src" "$dst"
    is_mirroring && return 0
    setsid -f wl-mirror --fullscreen-output "$dst" "$src"
}

extend() {
    pkill -x wl-mirror
    enable_external
    place
    return 0
}

internal() {
    local src dst
    src=$(source_output)
    dst=$(external_output)
    if [ -z "$dst" ]; then
        [ -z "$(disabled_external)" ] || return 0
        dms ipc call toast warn "No external display connected" >/dev/null 2>&1
        echo "no external display connected" >&2
        return 1
    fi
    pkill -x wl-mirror
    # labwc auto-places any output without an explicit position, so pin the panel.
    wlr-randr --output "$src" --pos "$(position "$src")" --output "$dst" --off
}

case "${1:-status}" in
    status) status ;;
    mirror) mirror ;;
    extend) extend ;;
    internal) internal ;;
    toggle) if is_mirroring; then extend; else mirror; fi ;;
    modes) modes ;;
    set-mode) set_mode "$2" ;;
    confirm-mode) confirm_mode ;;
    revert-mode) revert_mode "${2:-}" ;;
    restore-mode) restore_mode ;;
    placement) placement ;;
    set-placement) set_placement "${2:-}" ;;
    *) echo "usage: display-mode [status|toggle|mirror|extend|internal|modes|set-mode MODE|confirm-mode|revert-mode|restore-mode|placement|set-placement left|above|right]" >&2; exit 2 ;;
esac
