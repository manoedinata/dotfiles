+			if (abs(src_width - dst_box.width) <= 1 && abs(src_height - dst_box.height) <= 1) {
+				snapped_box.width = src_width;
+				snapped_box.height = src_height;
+				filter_mode = WLR_SCALE_FILTER_NEAREST;
+			}
+		}
